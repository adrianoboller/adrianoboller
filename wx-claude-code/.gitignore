
# binario e indice do wx-modelos: se refazem com cargo build --release
ferramentas/wx-modelos/target/

# entrega do wx-modelos: sai do publicar.py, nunca da arvore --
# binario commitado envelhece calado
ferramentas/wx-modelos/dist/

# entregaveis em zip: saem do empacotar-entregaveis.py, nunca da arvore
entregas/

# alvo do wl-rt: se refaz com cargo test
ferramentas/wl-rt/target/

# registro de operacoes que os testes gravam ao rodar o grafo sobre os exemplos
exemplos/*/destino/.wx-migration/logs/
