{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhxClaw",
  "identifier": "br.com.phxclaw.desktop",
  "build": {
    "frontendDist": "../../phxclaw-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhxClaw Command Center",
        "width": 1560,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
