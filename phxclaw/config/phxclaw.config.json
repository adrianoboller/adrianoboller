    "pdca_learning_policy": {
      "version": "0.44.0",
      "pdca": {
        "plan": "retrieve fruitful patterns and unfruitful anti-patterns before execution",
        "do": "execute assigned agent/model/skills under lease, fencing and budget",
        "check": "evaluate acceptance, QA, security, cost and quality evidence",
        "act": "create candidate fruitful or unfruitful knowledge and route through F24/F25 promotion"
      },
      "fruitful": {
        "purpose": "reuse proven context-compatible execution patterns",
        "promotion_required": true,
        "fields": [
          "task_class",
          "context_fingerprint",
          "source_state_sha256",
          "agent_uuid",
          "model_profile_uuid",
          "skill_versions",
          "quality_score",
          "actual_cost_usd",
          "evidence_refs",
          "confidence",
          "freshness"
        ]
      },
      "unfruitful": {
        "purpose": "avoid repeating context-equivalent failed attempts",
        "promotion_required": true,
        "fields": [
          "task_class",
          "context_fingerprint",
          "source_state_sha256",
          "failure_signature",
          "root_cause",
          "remediation",
          "avoidance_rule",
          "agent_uuid",
          "model_profile_uuid",
          "evidence_refs",
          "occurrence_count"
        ]
      },
      "guardrails": {
        "candidate_failure_never_blocks": true,
        "context_must_match_before_block": true,
        "knowledge_can_expire_or_be_superseded": true,
        "memory_is_not_truth": true,
        "raw_prompts_and_secrets_forbidden": true
      }
    }
