{
  "manifest_version": "1.3.0",
  "uuid": "01a0e5ed-9674-7bef-97b6-9e32dec13b52",
  "name": "com.phxclaw.external.template-creator",
  "version": "0.1.0",
  "kind": "tool",
  "description": "Governed external bridge for Template Creator. Declared in PhxClaw; disabled until a runtime connector is explicitly configured.",
  "core_api": ">=0.12.0, <1.0.0",
  "entrypoint": {
    "type": "process",
    "value": "community/bridges/chatgpt-capabilities/phxclaw-external-capability-bridge"
  },
  "dependencies": [],
  "capabilities": [
    "template.create"
  ],
  "extension_points": [
    {
      "point": "capability.provider",
      "contract_version": "^1.0.0"
    }
  ],
  "permissions": [],
  "lifecycle": {
    "install": "template-creator.bridge.install",
    "enable": "template-creator.bridge.enable",
    "disable": "template-creator.bridge.disable",
    "uninstall": "template-creator.bridge.uninstall",
    "health": "template-creator.bridge.health"
  },
  "contracts": {
    "input_schema": "schemas/extension-invocation.schema.json",
    "output_schema": "schemas/process-reply.schema.json"
  },
  "sandbox": {
    "network": "deny",
    "network_allowlist": [],
    "read_only_paths": [],
    "write_paths": [],
    "environment_allowlist": [],
    "timeout_ms": 30000,
    "memory_mb": 256,
    "cpu_quota_percent": 20
  },
  "integrity": {
    "artifact": "community/bridges/chatgpt-capabilities/phxclaw-external-capability-bridge",
    "hash_algorithm": "sha256",
    "digest": "<generated-by-phxclaw-plugin-pack>",
    "signature_algorithm": "ed25519",
    "signature": "<generated-by-phxclaw-plugin-sign>",
    "signer": "<private-publisher-signer-id>",
    "provenance": "Private PhxClaw external connector bridge; runtime credentials and provider connection are never embedded."
  },
  "tests": [
    {
      "name": "bridge-health",
      "command": "community/bridges/chatgpt-capabilities/phxclaw-external-capability-bridge --health",
      "required": true
    }
  ],
  "rollback": {
    "strategy": "disable_and_restore_previous",
    "steps": [
      "disable bridge route",
      "restore previous provider pin",
      "verify capability routing and evidence chain"
    ]
  }
}
