{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Skill Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_uuid",
    "eligible",
    "requires_human_approval",
    "path",
    "blockers"
  ],
  "properties": {
    "candidate_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "eligible": {
      "type": "boolean"
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "path": {
      "enum": [
        "auto_low_risk",
        "human_approval"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
