{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_uuid",
    "swarm_uuid",
    "tenant_uuid",
    "team",
    "source_state_sha256",
    "artifact_sha256",
    "evidence_refs",
    "passed"
  ],
  "properties": {
    "evidence_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "team": {
      "enum": [
        "research",
        "architecture",
        "coding",
        "qa",
        "security",
        "documentation"
      ]
    },
    "source_state_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
