{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/project-manifest.v1.json",
  "title": "PhxClaw Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_uuid",
    "name",
    "slug",
    "created_at",
    "paths",
    "version_control",
    "ai"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_opened_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "paths": {
      "type": "object",
      "required": [
        "root",
        "source",
        "logs",
        "artifacts",
        "backups"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs": {
          "type": "string"
        },
        "artifacts": {
          "type": "string"
        },
        "backups": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "tests": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "version_control": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "git",
            "none"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch": {
          "type": "string"
        },
        "current_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "required": [
        "agents",
        "skills",
        "models",
        "activity_bindings"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activity_bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  }
}
