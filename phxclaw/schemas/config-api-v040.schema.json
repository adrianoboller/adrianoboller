{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Config API v0.40",
  "type": "object",
  "required": [
    "method",
    "path",
    "concurrency"
  ],
  "additionalProperties": false,
  "properties": {
    "method": {
      "enum": [
        "GET",
        "PUT"
      ]
    },
    "path": {
      "const": "/v1/config"
    },
    "concurrency": {
      "const": "If-Match revision"
    },
    "content_type": {
      "const": "application/json"
    }
  }
}
