{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/agent-manifest.schema.json",
  "title": "PhxClaw Agent Manifest",
  "type": "object",
  "required": [
    "manifest_version", "uuid", "agent_id", "name", "mission", "capabilities",
    "permissions", "lifecycle", "models_allowed", "execution_policy", "source"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "uuid": {"type": "string", "format": "uuid"},
    "agent_id": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "macroarea": {"type": "string"},
    "nucleus": {"type": "string"},
    "role_type": {"type": "string"},
    "mission": {"type": "string"},
    "responsibilities": {"type": "string"},
    "resources": {"type": "string"},
    "authorized_actions": {"type": "string"},
    "trigger": {"type": "string"},
    "declared_dependencies": {"type": "string"},
    "resolved_agent_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "name"],
        "properties": {
          "uuid": {"type": "string", "format": "uuid"},
          "name": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "deliverables": {"type": "string"},
    "limits": {"type": "string"},
    "next_gate": {"type": "string"},
    "execution": {"type": "string"},
    "models_allowed": {"type": "array", "items": {"type": "string"}},
    "criticality": {"type": "string"},
    "modules": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scopes"],
        "properties": {
          "name": {"type": "string"},
          "scopes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {"enum": ["registered", "starting", "ready", "busy", "draining", "stopped", "failed", "quarantined"]}
    },
    "memory_skill_state": {"type": "string"},
    "event_topics": {"type": "string"},
    "execution_policy": {"type": "string"},
    "references": {"type": "string"},
    "knowledge_sources": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["workbook", "sheet", "row"],
      "properties": {
        "workbook": {"type": "string"},
        "sheet": {"type": "string"},
        "row": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
