{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/release-attestation-v025.schema.json",
  "title": "PhxClaw Release Attestation v0.25",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_uuid",
    "run_uuid",
    "release_uuid",
    "version",
    "workspace_sha256",
    "proof_bundle_sha256",
    "signing_payload_sha256",
    "assessment",
    "created_at"
  ],
  "properties": {
    "attestation_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "run_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "release_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "workspace_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "proof_bundle_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_sha256_hex",
        "source_ready",
        "static_verified",
        "runtime_verified",
        "e2e_verified",
        "release_ready",
        "verified_gates",
        "blockers"
      ],
      "properties": {
        "source_ready": {
          "type": "boolean"
        },
        "static_verified": {
          "type": "boolean"
        },
        "runtime_verified": {
          "type": "boolean"
        },
        "e2e_verified": {
          "type": "boolean"
        },
        "release_ready": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace_sha256_hex": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "verified_gates": {
          "type": "array",
          "items": {
            "enum": [
              "workspace_static",
              "json_schema_static",
              "migration_static",
              "license_sbom",
              "supply_chain",
              "cargo_fmt",
              "cargo_check",
              "cargo_test",
              "cargo_clippy",
              "postgres_migration",
              "rls_cross_tenant",
              "skill_knowledge_lineage",
              "mission_e2e",
              "tauri_native_e2e",
              "provider_model_e2e"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "signer_key_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "signature_b64": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16384
    },
    "signing_payload_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "signature_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ed25519",
        null
      ]
    }
  }
}
