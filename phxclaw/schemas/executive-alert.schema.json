{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Executive Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_uuid",
    "tenant_uuid",
    "severity",
    "kind",
    "title",
    "evidence_sha256",
    "created_at"
  ],
  "properties": {
    "alert_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "project_uuid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
