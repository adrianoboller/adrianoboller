{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tier",
    "provider",
    "model",
    "model_profile_uuid",
    "context_budget",
    "decision_sha256"
  ],
  "properties": {
    "tier": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "model_profile_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "context_budget": {
      "type": "object"
    },
    "decision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
