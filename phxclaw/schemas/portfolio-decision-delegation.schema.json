{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Portfolio Decision Delegation",
  "type": "object",
  "required": [
    "decision_case_uuid",
    "scenario_uuid",
    "scenario_hash",
    "simulation_evidence_sha256",
    "delegate_to",
    "direct_mutation"
  ],
  "properties": {
    "decision_case_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "scenario_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "simulation_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delegate_to": {
      "const": "executive_decision_center"
    },
    "direct_mutation": {
      "const": false
    }
  }
}
