{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Component Update Plan v0.28",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_core_version",
    "components",
    "policy_sha256",
    "signer_key_id",
    "signature_algorithm",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {
      "const": "0.28.0"
    },
    "target_core_version": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_uuid",
          "kind",
          "name",
          "version",
          "sha256",
          "reversible",
          "dependencies"
        ],
        "properties": {
          "component_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "preflight",
              "backup",
              "database_expand",
              "core",
              "plugin",
              "health_check",
              "database_contract",
              "cleanup"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "reversible": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "core_min": {
            "type": [
              "string",
              "null"
            ]
          },
          "core_max_exclusive": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 1
    }
  }
}
