{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw v0.36 Skill Route Plan",
  "type": "object",
  "required": [
    "request_uuid",
    "tenant_uuid",
    "catalog_sha256",
    "steps",
    "plan_sha256"
  ],
  "properties": {
    "request_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
