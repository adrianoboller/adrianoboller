{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/ai-route-request-v031.schema.json",
  "title": "ai-route-request-v031",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "tenant_uuid",
    "request_uuid",
    "classification",
    "required_capabilities",
    "prompt_sha256"
  ],
  "properties": {
    "tenant_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "request_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "tools",
          "structured_output",
          "vision",
          "embeddings",
          "reasoning",
          "audio"
        ]
      },
      "uniqueItems": true
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allow_cloud": {
      "type": "boolean"
    },
    "allow_fallback": {
      "type": "boolean"
    },
    "min_reasoning_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  }
}
