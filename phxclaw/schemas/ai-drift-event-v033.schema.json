{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_uuid",
    "arena_uuid",
    "champion",
    "baseline_profile_sha256",
    "observed_window_sha256",
    "severity",
    "action",
    "event_sha256"
  ],
  "properties": {
    "severity": {
      "enum": [
        "none",
        "warning",
        "critical"
      ]
    },
    "action": {
      "enum": [
        "continue",
        "pause_arena",
        "fallback_base_router"
      ]
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
