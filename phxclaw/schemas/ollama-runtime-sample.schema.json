{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "loaded"
  ],
  "properties": {
    "model": {
      "type": "string"
    },
    "loaded": {
      "type": "boolean"
    },
    "size_vram": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "queue_depth": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tokens_per_second": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
