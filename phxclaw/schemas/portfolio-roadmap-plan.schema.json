{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/portfolio-roadmap-plan.schema.json",
  "type": "object",
  "properties": {
    "plan_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "source_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected_candidate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1
    },
    "total_budget_reserved": {
      "type": "number",
      "minimum": 0
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requires_approval": {
      "type": "boolean"
    }
  },
  "required": [
    "plan_uuid",
    "source_state_sha256",
    "selected_candidate_hash",
    "items",
    "total_budget_reserved",
    "plan_sha256",
    "requires_approval"
  ],
  "additionalProperties": false
}
