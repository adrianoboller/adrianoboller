{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/portfolio-project-demand.schema.json",
  "type": "object",
  "properties": {
    "project_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "priority": {
      "type": "integer"
    },
    "locked": {
      "type": "boolean"
    },
    "duration_days": {
      "type": "integer",
      "minimum": 1
    },
    "budget_required": {
      "type": "number",
      "minimum": 0
    },
    "dependencies": {
      "type": "array"
    }
  },
  "required": [
    "project_uuid",
    "priority",
    "locked",
    "duration_days",
    "budget_required",
    "dependencies"
  ],
  "additionalProperties": false
}
