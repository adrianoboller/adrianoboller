{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phoenix://schemas/device-envelope-v1",
  "title": "PhxClaw Device Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "node_uuid",
    "session_uuid",
    "message_uuid",
    "sequence",
    "sent_at",
    "nonce_hex",
    "kind",
    "body_b64",
    "body_sha256_hex",
    "signature_b64"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "node_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "session_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "message_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce_hex": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "body_b64": {
      "type": "string",
      "maxLength": 16777216
    },
    "body_sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100
    }
  }
}
