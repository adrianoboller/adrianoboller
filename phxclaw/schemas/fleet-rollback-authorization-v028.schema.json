{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Fleet Rollback Authorization v0.28",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_uuid",
    "rollout_uuid",
    "from_version",
    "to_version",
    "from_sequence",
    "to_sequence",
    "max_nodes",
    "reason",
    "created_at",
    "expires_at",
    "signer_key_id",
    "signature_algorithm",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {
      "const": "0.28.0"
    },
    "authorization_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "rollout_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "from_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "to_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_key_id": {
      "type": "string"
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 1
    }
  }
}
