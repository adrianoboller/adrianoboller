{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw Portfolio Simulation Result",
  "type": "object",
  "required": [
    "run_uuid",
    "scenario_uuid",
    "twin_hash",
    "scenario_hash",
    "iterations",
    "portfolio_cost",
    "evidence_sha256"
  ],
  "properties": {
    "run_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "scenario_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "twin_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iterations": {
      "type": "integer"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
