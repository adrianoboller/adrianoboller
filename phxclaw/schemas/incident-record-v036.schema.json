{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhxClaw v0.36 Incident Record",
  "type": "object",
  "required": [
    "incident_uuid",
    "tenant_uuid",
    "severity",
    "title",
    "detection_evidence_sha256",
    "state"
  ],
  "properties": {
    "incident_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "detection_evidence_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
