{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "arena_uuid",
    "request_uuid",
    "served",
    "assignment_bucket",
    "assignment_sha256"
  ],
  "properties": {
    "assignment_bucket": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
