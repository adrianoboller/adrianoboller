{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Drift Event",
  "type": "object",
  "required": [
    "drift_uuid",
    "project_uuid",
    "kind",
    "severity",
    "evidence_sha256"
  ],
  "properties": {
    "drift_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "project_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "Info",
        "Warning",
        "High",
        "Critical"
      ]
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
