{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/community-registry.schema.json",
  "title": "PhxClaw Community Registry",
  "type": "object",
  "required": ["registry_version", "generated_at", "publishers", "releases"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "signer", "trust_tier"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "website": {"type": ["string", "null"]},
          "repository": {"type": ["string", "null"]},
          "signer": {"type": "string", "minLength": 1},
          "trust_tier": {"enum": ["builtin", "verified", "community", "local_development"]}
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plugin_uuid", "name", "version", "core_api", "publisher_id", "license",
          "source_repository", "package_url", "package_sha256", "manifest_sha256",
          "signature_algorithm", "signature", "signer", "provenance", "categories",
          "capabilities", "extension_points", "published_at", "yanked"
        ],
        "properties": {
          "plugin_uuid": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "core_api": {"type": "string", "minLength": 1},
          "publisher_id": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "source_repository": {"type": "string", "minLength": 1},
          "documentation_url": {"type": ["string", "null"]},
          "package_url": {"type": "string", "minLength": 1},
          "package_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "signature_algorithm": {"const": "ed25519"},
          "signature": {"type": "string", "minLength": 1},
          "signer": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "categories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "extension_points": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "published_at": {"type": "string", "format": "date-time"},
          "yanked": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
