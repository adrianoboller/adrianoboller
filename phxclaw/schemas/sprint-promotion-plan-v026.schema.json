{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "source_state_sha256",
    "qualification_run_uuid",
    "sprints",
    "summary"
  ],
  "properties": {
    "version": {
      "const": "0.26.0"
    },
    "source_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_run_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sprints": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "required": [
          "sprint",
          "status",
          "required_gates",
          "verified_gates",
          "missing_gates"
        ],
        "properties": {
          "sprint": {
            "type": "string",
            "pattern": "^F(?:0[0-9]|1[0-9]|2[0-5])$"
          },
          "status": {
            "enum": [
              "green",
              "yellow"
            ]
          },
          "required_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
