{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_uuid",
    "arena_uuid",
    "from_state",
    "to_state",
    "actor_id",
    "policy_sha256",
    "occurred_at_unix",
    "event_sha256"
  ],
  "properties": {
    "from_state": {
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "to_state": {
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
