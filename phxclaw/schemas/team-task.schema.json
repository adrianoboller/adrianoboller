{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/team-task.schema.json",
  "title": "PhxClaw Team Task",
  "type": "object",
  "required": [
    "uuid",
    "name",
    "capability",
    "depends_on",
    "state",
    "fencing_token",
    "attempts"
  ],
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "worker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
