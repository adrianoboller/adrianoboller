{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/model-response.schema.json",
  "title": "PhxClaw Model Provider Response",
  "type": "object",
  "required": ["request_uuid", "provider_uuid", "model_id", "output", "input_tokens", "output_tokens", "cost_microunits", "latency_ms"],
  "properties": {
    "request_uuid": {"type": "string", "format": "uuid"},
    "provider_uuid": {"type": "string", "format": "uuid"},
    "model_id": {"type": "string", "minLength": 1},
    "output": {},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_microunits": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
