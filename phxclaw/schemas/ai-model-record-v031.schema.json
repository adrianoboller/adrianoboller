{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/ai-model-record-v031.schema.json",
  "title": "ai-model-record-v031",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "tenant_uuid",
    "provider_uuid",
    "model_id",
    "location",
    "capabilities",
    "context_tokens",
    "observed_at_unix",
    "catalog_ttl_seconds",
    "reasoning_tier"
  ],
  "properties": {
    "tenant_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "provider_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "enum": [
        "local",
        "cloud"
      ]
    },
    "capabilities": {
      "type": "array"
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "reasoning_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  }
}
