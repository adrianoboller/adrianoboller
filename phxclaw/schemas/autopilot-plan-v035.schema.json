{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Autopilot Plan v0.35",
  "type":"object","additionalProperties":false,
  "required":["tenant_uuid","plan_uuid","sre_policy_document_sha256","portfolio_document_sha256","source_state_sha256","trigger_evidence_hashes","created_at_unix","expires_at_unix","automatic_allowed","requires_human_approval","actions"],
  "properties": {
    "tenant_uuid":{"type":"string","format":"uuid"},
    "plan_uuid":{"type":"string","format":"uuid"},
    "sre_policy_document_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "portfolio_document_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_state_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "trigger_evidence_hashes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "created_at_unix":{"type":"integer"},
    "expires_at_unix":{"type":"integer"},
    "automatic_allowed":{"type":"boolean"},
    "requires_human_approval":{"type":"boolean"},
    "actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"}}
  },
  "$defs": {
    "action": {
      "type":"object","additionalProperties":false,
      "required":["kind","slot_uuid","provider_uuid","model_id","to_provider_uuid","to_model_id","magnitude_basis_points","projected_cost_delta_micro_usd","reversible"],
      "properties": {
        "kind":{"enum":["throttle","drain_provider","resume_provider","decrease_concurrency","increase_concurrency","rebalance_share","request_capacity_increase"]},
        "slot_uuid":{"type":["string","null"],"format":"uuid"},
        "provider_uuid":{"type":"string","format":"uuid"},
        "model_id":{"type":["string","null"]},
        "to_provider_uuid":{"type":["string","null"],"format":"uuid"},
        "to_model_id":{"type":["string","null"]},
        "magnitude_basis_points":{"type":"integer","minimum":0,"maximum":10000},
        "projected_cost_delta_micro_usd":{"type":"integer"},
        "reversible":{"type":"boolean"}
      }
    }
  }
}
