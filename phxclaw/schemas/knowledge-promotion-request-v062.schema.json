{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phxclaw.local/schemas/knowledge-promotion-request-v062.schema.json",
  "type":"object","additionalProperties":false,
  "required":["request_uuid","tenant_uuid","claim_node_uuid","target_state","expected_source_state_sha256_hex","requested_by","requested_at","evidence"],
  "properties":{
    "request_uuid":{"type":"string","format":"uuid"},"tenant_uuid":{"type":"string","format":"uuid"},"candidate_uuid":{"type":["string","null"],"format":"uuid"},
    "claim_node_uuid":{"type":"string","format":"uuid"},"target_state":{"enum":["accepted","governed"]},
    "expected_source_state_sha256_hex":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"requested_by":{"type":"string","minLength":1,"maxLength":200},
    "requested_at":{"type":"string","format":"date-time"},"evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["evidence_uuid","evidence_sha256_hex","source_state_sha256_hex","mechanism","relation","collected_at"],"properties":{
        "evidence_uuid":{"type":"string","format":"uuid"},"evidence_sha256_hex":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "source_state_sha256_hex":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"mechanism":{"type":"string","minLength":1,"maxLength":160},
        "relation":{"enum":["supports","refutes"]},"collected_at":{"type":"string","format":"date-time"},"valid_until":{"type":["string","null"],"format":"date-time"}
      }}}
  }
}
