{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/skill-manifest.schema.json",
  "title": "PhxClaw Skill Manifest",
  "type": "object",
  "required": [
    "uuid", "name", "version", "description", "state", "required_capabilities",
    "steps", "input_schema", "output_schema", "provenance", "evidence",
    "created_at", "updated_at", "sha256"
  ],
  "properties": {
    "uuid": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$"},
    "description": {"type": "string", "minLength": 1},
    "state": {"enum": ["candidate", "validated", "promoted", "disabled", "rejected"]},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "instruction", "requires_human_approval"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "instruction": {"type": "string", "minLength": 1},
          "capability": {"type": ["string", "null"]},
          "requires_human_approval": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "triggers": {"type": "array", "items": {"type": "string"}},
    "knowledge_sources": {"type": "array", "items": {"type": "string"}},
    "context_namespaces": {"type": "array", "items": {"type": "string"}},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "uri", "source_type", "retrieved_at", "sha256"],
        "properties": {
          "uuid": {"type": "string", "format": "uuid"},
          "uri": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
