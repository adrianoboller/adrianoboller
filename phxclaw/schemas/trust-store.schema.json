{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/trust-store.schema.json",
  "title": "PhxClaw Plugin Trust Store",
  "type": "object",
  "required": ["version", "signers"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "algorithm", "public_key_base64", "status", "allowed_name_prefixes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "ed25519"},
          "public_key_base64": {"type": "string", "minLength": 40},
          "status": {"enum": ["active", "revoked", "disabled"]},
          "allowed_name_prefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
