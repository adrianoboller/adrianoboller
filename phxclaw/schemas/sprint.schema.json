{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phxclaw.local/schemas/sprint.schema.json",
  "title": "PhxClaw Sprint",
  "type": "object",
  "required": ["uuid", "code", "title", "goal", "status", "tasks", "definition_of_done"],
  "properties": {
    "uuid": {"type": "string", "format": "uuid"},
    "code": {"type": "string", "pattern": "^F[0-9]{2,}$"},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "active", "blocked", "review", "done"]},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "title", "status"],
        "properties": {
          "uuid": {"type": "string", "format": "uuid"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "active", "blocked", "review", "done"]}
        },
        "additionalProperties": false
      }
    },
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
